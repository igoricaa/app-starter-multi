{
  "name": "app-starter-multi",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '@app/api' --filter '@app/web' dev",
    "check": "oxfmt --check && bunx --bun oxlint --type-aware && knip && bun run typecheck && bun run --filter '*' test",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "fmt": "oxfmt",
    "e2e": "playwright test",
    "setup": "bun scripts/setup.ts"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.15.4",
    "@oxlint/plugins": "^1.90.0",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "0.2.3",
    "@types/node": "^26.6.5",
    "e2e": "^0.22.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
